  "fixed_sql": [
    {
      "name": "positions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"positions\" (\"id\" TEXT NOT NULL, \"asset_id\" TEXT NOT NULL, \"asset_symbol\" TEXT NOT NULL, \"asset_name\" TEXT NOT NULL, \"quote\" TEXT NOT NULL, \"qty\" TEXT NOT NULL, \"avg_price\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"note\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "candle_cache",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"candle_cache\" (\"source_id\" TEXT NOT NULL, \"symbol\" TEXT NOT NULL, \"interval\" TEXT NOT NULL, \"open_time\" INTEGER NOT NULL, \"open\" TEXT NOT NULL, \"high\" TEXT NOT NULL, \"low\" TEXT NOT NULL, \"close\" TEXT NOT NULL, \"volume\" TEXT NULL, \"stored_at\" INTEGER NOT NULL, PRIMARY KEY (\"source_id\", \"symbol\", \"interval\", \"open_time\"));"
        }
      ]
    },
    {
      "name": "last_quotes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"last_quotes\" (\"source_id\" TEXT NOT NULL, \"symbol\" TEXT NOT NULL, \"asset_id\" TEXT NOT NULL, \"asset_symbol\" TEXT NOT NULL, \"asset_name\" TEXT NOT NULL, \"quote\" TEXT NOT NULL, \"price\" TEXT NOT NULL, \"change24h_pct\" TEXT NULL, \"at\" INTEGER NOT NULL, PRIMARY KEY (\"source_id\", \"symbol\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    }
